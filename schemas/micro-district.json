{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "@context": {
    "gm": "https://glassmap.org/ontology/",
    "schema": "http://schema.org/",
    "population": "schema:population",
    "area": "schema:areaServed",
    "services": "gm:serviceProvider"
  },
  "type": "object",
  "required": ["id", "name", "population", "zip_codes", "services"],
  "properties": {
    "id": { "type": "string", "pattern": "^gm:micro:[0-9]{5}$" },
    "name": { "type": "string" },
    "population": { "type": "integer", "minimum": 50000, "maximum": 70000 },
    "zip_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{5}$" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "provider": { "type": "string" },
          "tier": { "enum": ["Micro", "Regional", "Systemic"] }
        }
      }
    }
  }
}
